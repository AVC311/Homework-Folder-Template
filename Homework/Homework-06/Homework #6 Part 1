#include <iostream>
#include <vector>
#include <algorithm>
using namespace std;
int main()
{
    vector<int> data = {1, 3, 6, 7, 9};
    vector<int> data1 = {5, 3, 3, 11};

    cout << "data[]: { ";
    for(size_t i = 0; i < data.size(); ++i)
    {
        cout << data[i] << (i == data.size() - 1 ? "" : ", ");
    }
    cout << " }" << endl;

    cout << "data1[]: { ";
    for(size_t i = 0; i < data1.size(); ++i)
    {
        cout << data1[i] << (i == data1.size() - 1 ? "" : ", ");
    }
    cout << " }" << endl;

    swap(data, data1);

    cout << "Swapped data[]: { ";
    for(size_t i = 0; i < data.size(); ++i)
    {
        cout << data[i] << (i == data.size() - 1 ? "" : ", ");
    }
    cout << " }" << endl;

    cout << "Swapped data1[]: { ";
    for(size_t i = 0; i < data1.size(); ++i)
    {
        cout << data1[i] << (i == data1.size() - 1 ? "" : ", ");
    }
    cout << " }" << endl;
}
