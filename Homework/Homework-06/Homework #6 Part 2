#include <iostream>
using namespace std;

void Com(int data[], size_t size1, int data1[], size_t size2)
{
    cout << "Common numbers: ";
    for (size_t i = 0; i<size1; ++i)
    {
        for (size_t j = 0; j < size2; ++j)
        {
            if (data[i] == data1[j])
            {
                cout << data[i] << " ";
                break;
            }
        }
    }
    cout << endl;
}
int main()
{
    int data[] = {1, 3, 6, 7, 9};
    int data1[] = {5, 3, 3, 11};
    Com(data, 5, data1, 4);
}
